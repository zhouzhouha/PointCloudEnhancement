+def _fallback_furthestsampling(xyz, m):
+    """Small inference-only FPS fallback for APU-LDI smoke tests."""
+    b, n, _ = xyz.shape
+    m = min(int(m), n)
+    idx = torch.zeros((b, m), dtype=torch.long, device=xyz.device)
+    dist = torch.full((b, n), float("inf"), dtype=xyz.dtype, device=xyz.device)
+    farthest = torch.zeros((b,), dtype=torch.long, device=xyz.device)
+    batch = torch.arange(b, device=xyz.device)
+    for i in range(m):
+        idx[:, i] = farthest
+        centroid = xyz[batch, farthest].unsqueeze(1)
+        dist = torch.minimum(dist, torch.sum((xyz - centroid) ** 2, dim=-1))
+        farthest = torch.max(dist, dim=1)[1]
+    return idx.int()
+
+
+def _fallback_knnquery_heap(nsample, xyz, new_xyz=None):
+    """Inference-only KNN fallback matching pointops' index output shape."""
+    if new_xyz is None:
+        new_xyz = xyz
+    nsample = min(int(nsample), xyz.shape[1])
+    dist = torch.cdist(new_xyz, xyz)
+    return torch.topk(dist, k=nsample, dim=-1, largest=False)[1].int()
+
+
+if pointops_cuda is None:
+    furthestsampling = _fallback_furthestsampling
+    knnquery_heap = _fallback_knnquery_heap
+
